.venv
.github
notebooks
scripts
docs
infra
tests
artifacts
data
mlruns
*.epub
*.xlsx
*.ipynb
__pycache__
*.pyc
.DS_Store
.pytest_cache
README.md
LICENSE
requirements.txt
