{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadModelArtifact",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::goldmlops-data-686699774218/models/*"
        },
        {
            "Sid": "WriteOwnLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-east-1:686699774218:log-group:/aws/lambda/goldmlops-api:*"
        }
    ]
}
