{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "WriteDataLake",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": [
                "arn:aws:s3:::goldmlops-data-<ACCOUNT_ID>/raw/*",
                "arn:aws:s3:::goldmlops-data-<ACCOUNT_ID>/features/*"
            ]
        },
        {
            "Sid": "WriteOwnLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/lambda/goldmlops-ingest:*"
        }
    ]
}